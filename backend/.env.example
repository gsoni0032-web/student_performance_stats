# Copy to backend/.env for local development without Docker. See the README for every variable.
APP_ENV=development
SECRET_KEY=change-me-use-python-secrets-token-urlsafe-48-to-make-a-real-one
DATABASE_URL=sqlite:///./pathway.db
CORS_ORIGINS=http://localhost:5173
MODEL_DIR=./model_store
LOG_LEVEL=INFO
LOG_JSON=false
