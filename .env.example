# Base URL of the Pathway API. Leave as-is when the frontend and API share a domain
# (docker-compose, nginx). For Vercel or Netlify use the full backend URL, e.g.
# https://pathway-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Dev only: where the Vite dev server proxies /api
VITE_DEV_API_TARGET=http://localhost:8000
