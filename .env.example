# Copy to .env (never commit it). docker-compose reads this file.
# Generate a secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database -----------------------------------------------------------------
POSTGRES_DB=pathway
POSTGRES_USER=pathway
POSTGRES_PASSWORD=change-me-database-password

# --- Backend ------------------------------------------------------------------
APP_ENV=production
SECRET_KEY=change-me-generate-a-long-random-string-at-least-32-characters
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080
# Turn on once the site is served over HTTPS (redirects http to https, sends HSTS).
FORCE_HTTPS=false
ENABLE_DOCS=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10
LOG_LEVEL=INFO

# --- Ports --------------------------------------------------------------------
WEB_PORT=8080
